.date-card {
  text-align: center;
  padding: 48rpx 32rpx;
}

.solar {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
}

.week {
  display: block;
  margin-top: 8rpx;
  color: #9A8F85;
  font-size: 26rpx;
}

.divider {
  width: 80rpx;
  height: 4rpx;
  background: #B03A2E;
  margin: 28rpx auto;
  border-radius: 2rpx;
}

.lunar {
  display: block;
  font-size: 36rpx;
  color: #B03A2E;
  font-weight: 600;
}

.gz {
  display: block;
  margin-top: 8rpx;
  color: #9A8F85;
  font-size: 26rpx;
}

.yiji-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.tag {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  text-align: center;
  border-radius: 12rpx;
  color: #fff;
  font-size: 28rpx;
  margin-right: 20rpx;
}

.yi-tag {
  background: #B03A2E;
}

.ji-tag {
  background: #4A4A4A;
}

.yiji-text {
  flex: 1;
  line-height: 56rpx;
  font-size: 28rpx;
}

.yiji-note {
  display: block;
  margin-top: 16rpx;
  color: #C4BBB2;
  font-size: 22rpx;
}

.festival-badge {
  display: inline-block;
  margin-top: 20rpx;
  padding: 8rpx 28rpx;
  background: #B03A2E;
  color: #fff;
  font-size: 26rpx;
  border-radius: 999rpx;
  letter-spacing: 2rpx;
}

.quote-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.quote-title {
  font-size: 26rpx;
  color: #9A8F85;
  letter-spacing: 4rpx;
}

.shuffle-btn {
  font-size: 24rpx;
  color: #B03A2E;
  border: 1rpx solid #B03A2E;
  border-radius: 999rpx;
  padding: 6rpx 24rpx;
}

.quote-text {
  display: block;
  font-size: 32rpx;
  line-height: 1.8;
  font-weight: 500;
}

.quote-from {
  display: block;
  margin-top: 16rpx;
  text-align: right;
  color: #9A8F85;
  font-size: 26rpx;
}
